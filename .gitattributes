# Windows runners check out with core.autocrlf=true by default; tests that
# read action.yml, the README and the sources line-by-line must see the same
# bytes on every OS, so every text file is LF in the working tree everywhere.
* text=auto eol=lf
*.pdf binary
# Invoices in ISO-8859-1 and UTF-16: their bytes are what the tests are about,
# so no checkout may normalise them.
test/fixtures/encodings/*.xml binary
